Options -Indexes
RewriteEngine On
RewriteBase /

# ── 1. API — pass through to api/.htaccess ────────────────────────────────────
RewriteRule ^api(/.*)?$ - [L]

# ── 2. Vite assets live in admin/assets/ but HTML references them as ./assets/ ─
RewriteRule ^assets/(.+)$      /admin/assets/$1       [L]
RewriteRule ^favicon\.ico$     /admin/favicon.ico      [L]
RewriteRule ^favicon\.svg$     /admin/favicon.svg      [L]
RewriteRule ^placeholder\.svg$ /admin/placeholder.svg  [L]
RewriteRule ^robots\.txt$      /admin/robots.txt        [L]

# ── 3. Files already inside admin/ — serve directly ──────────────────────────
RewriteRule ^admin/ - [L]

# ── 4. Real physical files (if any) — serve directly ─────────────────────────
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# ── 5. Everything else (including /) → React SPA ─────────────────────────────
RewriteRule ^ /admin/index.html [L]

# ── Security headers (admin dashboard) ───────────────────────────────────────
# Wrapped in IfModule so a missing mod_headers can never 500/403 the site.
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(self), payment=()"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>
